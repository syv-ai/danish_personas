# Copy this file to `.env` and fill in the values. Never commit `.env`.

# Git identity used by `make setup-git` for local commits.
GIT_NAME=
GIT_EMAIL=

# Optional bearer tokens referenced by a local generation configuration through
# `api_key_env`. Generation reads this file when it resolves the provider token; an
# existing environment variable still wins.
OPENAI_API_KEY=
HF_TOKEN=
